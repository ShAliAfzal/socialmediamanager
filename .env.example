PORT=4100
MONGO_URI=mongodb://127.0.0.1:27017/socialmediamanager
JWT_SECRET=change-me-to-a-long-random-string
WEB_ORIGIN=http://localhost:5173
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
SEED_ADMIN_EMAIL=admin@socialmediamanager.app
SEED_ADMIN_PASSWORD=Admin@12345
SEED_CLIENT_EMAIL=client@ecomrisers.com
SEED_CLIENT_PASSWORD=Ecom@12345
# Optional — can also set in Admin → Settings UI
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
HEYGEN_API_KEY=
# Google Flow video (Gemini API key from https://aistudio.google.com/apikey)
GOOGLE_FLOW_API_KEY=
GOOGLE_FLOW_MODEL=gemini-omni-1.1-flash
# auto | heygen | google_flow
VIDEO_PROVIDER=auto
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
META_GRAPH_VERSION=v21.0
DRY_RUN_PUBLISH=true
# Public URL for Meta to fetch uploaded images (set in production)
PUBLIC_BASE_URL=http://localhost:4100
# Optional override for upload directory
# UPLOADS_DIR=
